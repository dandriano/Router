@page "/"

@using Blazorex
@using Router.Enums

<MudToolBar>
    <MudToggleGroup T="Enums.GraphMode" @bind-Value="_graphMode">
        @foreach (var enumValue in Enum.GetValues<Enums.GraphMode>())
        {
            <MudToggleItem Value="enumValue" Key="@enumValue">
                @enumValue.ToString()
            </MudToggleItem>
        }
    </MudToggleGroup>
</MudToolBar>
<MudPaper>
    <Canvas Width="@_width" Height="@_height" OnFrameReady="(t) => OnFrameReady(t)" OnCanvasReady="(ctx) => OnCanvasReady(ctx)"/>
</MudPaper>
<MudText Typo="Typo.caption">FPS: @((int)(_elapsedTime > 0 ? 1000f / _elapsedTime : 0))</MudText>

@code {
    private GraphMode _graphMode;
    private int _width = 800;
    private int _height = 600;
    private float _lastUpdate = 0;
    private float _elapsedTime = 0;
    private IRenderContext? _ctx;
    private Network _network = new Network();

    private void OnCanvasReady(CanvasBase canvas)
    {
        _ctx = canvas.RenderContext;
    }

    private void OnFrameReady(float timestamp)
    {
        // TODO: clear frame if needed
        // _ctx!.ClearRect(0, 0, _width, _height);

        // update time stamps
        _elapsedTime = timestamp - _lastUpdate;
        _lastUpdate = timestamp;

        // TODO: proceed/draw requests to (re)place graph entities
    }
}
