@page "/"

@using Blazorex
@using Router.Enums

<MudStack>
    <MudToolBar>
        <MudToggleGroup T="Enums.GraphMode" @bind-Value="_graphMode">
            @foreach (var enumValue in Enum.GetValues<Enums.GraphMode>())
            {
                <MudToggleItem Value="enumValue">
                    @enumValue.ToString()
                </MudToggleItem>
            }
        </MudToggleGroup>
    </MudToolBar>
    <Canvas Width="@_width" Height="@_height"
            OnFrameReady="(t) => OnFrameReady(t)" 
            OnCanvasReady="(ctx) => OnCanvasReady(ctx)"
            OnMouseDown="(m) => OnMouseDown(m)"
            OnMouseUp="(m) => OnMouseUp(m)"
            OnMouseMove="(c) => OnMouseMove(c)"
            OnMouseWheel="(d) => OnMouseWheel(d)"
            OnResize="(s) => OnResize(s)" />
    <MudText Typo="Typo.caption">FPS: @((int)(_elapsedTime > 0 ? 1000f / _elapsedTime : 0))    
                                    Size: @_width X @_height
                                        Coord: @_x/@_xc X @_y/@_yc</MudText>
</MudStack>


@code {
    [CascadingParameter]
    public MudTheme? Theme { get; init; }       // ugly..
    private GraphMode _graphMode;
    private float _lastUpdate = 0;
    private float _elapsedTime = 0;
    private bool _hasChanges = true;
    private IRenderContext? _ctx;
    private Network? _network;
    private NetworkSettings? _settings;
    private NetworkRenderer? _renderer;
    private int _width = 800;
    private int _height = 600;
    //--- pan and scale
    private float _x;
    private float _y;
    private float _xc;
    private float _yc;
    private float _scale;
    private bool _isMouseDown;
    //---

    private void OnCanvasReady(CanvasBase canvas)
    {
        _ctx = canvas.RenderContext;
        _network = new Network();

        _settings = NetworkSettings.Default;
        _settings.SetSize(_width, _height);
        _settings.SetColour(Theme!.PaletteDark.Black.Value, Theme.PaletteDark.Background.Value);
        _settings.SetVertexColour(Theme.PaletteDark.Primary.Value, Theme.PaletteDark.Background.Value);
        
        _renderer = new NetworkRenderer(_settings);
    }

    private void OnMouseWheel(WheelDelta d) 
    {
        /* TODO: implement scale
        var newScale = _scale + (float)d.DeltaY * -0.001f;
    
        _x = (float)d.ClientX - ((float)d.ClientX - _x) * (newScale / _scale);
        _y = (float)d.ClientY - ((float)d.ClientY - _y) * (newScale / _scale);
        _scale = newScale;
        */
    }

    private void OnMouseDown(MouseButtonData m) => _isMouseDown = true;
    private void OnMouseUp(MouseButtonData m) 
    {
        _isMouseDown = false;

        if(_graphMode != GraphMode.Edit)
            return;

        _x = (float)m.OffsetX;
        _y = (float)m.OffsetY;

        _network!.AddVertex(new Node($"{_x:f2}\t{_y:f2}"), _x, _y);
        _hasChanges = true;
    }

    private void OnMouseMove(MouseCoords c)
    {
        _x = (float)c.OffsetX;
        _y = (float)c.OffsetY;

        _xc = _x - _width / 2;
        _yc = -(_y - _height / 2);

        if (_graphMode != GraphMode.Select || !_isMouseDown)
            return;

        // TODO: implement pan
    }

    private void OnResize(Blazorex.Size size) 
    {
        /* TODO: implement reaction on resize
        _settings!.SetSize(size.Width, size.Height);
        _hasChanges = true;
        */
    }

    private void OnFrameReady(float timestamp)
    {
        // update time stamps
        _elapsedTime = timestamp - _lastUpdate;
        _lastUpdate = timestamp;

        if (!_hasChanges)
            return;

        _hasChanges = false;
        _renderer!.Render(_ctx!, _network!);
    }
}
